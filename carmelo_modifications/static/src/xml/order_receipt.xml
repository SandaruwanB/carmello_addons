<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="carmelo_modifications.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-order-data')]/p" position="replace"/>
        <xpath expr="//div[@id='order-date']" position="after">
            <div class="pos-receipt-thank-you">
                Thank you! Come again
            </div>
        </xpath>
    </t>

</templates>
