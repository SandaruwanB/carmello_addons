<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_pdc_customer_payment" model="ir.sequence">
            <field name="name">PDC Customer Cheque Payment</field>
            <field name="code">pdc.payment.customer</field>
            <field name="prefix">CUST.IN/PDC/</field>
            <field name="padding">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_pdc_vendor_payment" model="ir.sequence">
            <field name="name">PDC Vendor Cheque Payment</field>
            <field name="code">pdc.payment.vendor</field>
            <field name="prefix">SUPP.OUT/PDC/</field>
            <field name="padding">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
