<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_pdc" model="ir.module.category">
            <field name="name">PDC Management</field>
            <field name="description">Manage Post Dated Cheques and Approvals</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_pdc_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_pdc"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_pdc_manager" model="res.groups">
            <field name="name">Approver / Manager</field>
            <field name="category_id" ref="module_category_pdc"/>
            <field name="implied_ids" eval="[(4, ref('group_pdc_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
