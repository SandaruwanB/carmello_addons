<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_petty_cash_form" model="ir.ui.view">
        <field name="name">hr.employee.form.petty.cash</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="cash_issue_ids" invisible="1"/>
                <button name="button_view_cash_issues" icon="fa-hand-holding-usd" class="oe_stat_button" type="object" invisible="not cash_issue_ids">
                    <div class="o_stat_info">
                        <span class="o_stat_text">IOU Requests</span>
                    </div>
                </button>

                <field name="cash_out_ids" invisible="1"/>
                <button name="button_view_cash_out" icon="fa-receipt" class="oe_stat_button" type="object" invisible="not cash_out_ids">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Reimbursements</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="before">
                <field name="issued_petty_cash" invisible="1"/>
                <field name="expensed_petty_cash" invisible="1"/>
                <field name="pay_to_employee" widget="monetary"/>
                <field name="cash_issue_ids" invisible="1"/>
                <field name="cash_out_ids" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_employee_petty_cash_tree" model="ir.ui.view">
        <field name="name">hr.employee.tree.petty.cash</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Employee Petty Cash Report" sample="1">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="job_id" optional="show"/>
                <field name="pay_to_employee" widget="monetary" sum="Total Balance"/>
                <field name="work_phone" class="o_force_ltr" optional="hide"/>
                <field name="work_email" optional="hide"/>
                <field name="issued_petty_cash" column_invisible="1"/>
                <field name="expensed_petty_cash" column_invisible="1"/>
                <field name="coach_id" column_invisible="1"/>
                <field name="parent_id" column_invisible="1"/>
                <field name="pay_petty_cash" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_employee_filter" model="ir.ui.view">
        <field name="name">hr.employee.search.petty.cash</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <search string="Employees">
                <field name="name" string="Employee" filter_domain="['|', ('work_email', 'ilike', self), ('name', 'ilike', self)]"/>
                <field name="category_ids" groups="hr.group_hr_user"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <separator/>
                <filter string="Pay to Employee" name="pay_to_employee" domain="[('pay_petty_cash', '&gt;', 0)]"/>
                <filter string="Balanced" name="pay_balance" domain="[('pay_petty_cash', '=', 0.00)]"/>
                <filter string="Pay to Company" name="pay_from" domain="[('pay_petty_cash', '&lt;', 0.00)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_department" string="Department" domain="[]" context="{'group_by': 'department_id'}"/>
                    <filter name="group_job" string="Job Position" domain="[]" context="{'group_by': 'job_id'}"/>
                    <filter name="group_manager" string="Manager" domain="[]" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_company" string="Company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_petty_cash_form" model="ir.ui.view">
        <field name="name">petty.cash.form</field>
        <field name="model">petty.cash</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Drawer">
                <header>
                    <button name="button_confirm_petty_cash" type="object" string="Confirm" class="btn-primary" groups="petty_cash.petty_cash_group_manager" invisible="state != 'draft'"/>
                    <button name="button_petty_cash_in" type="object" string="Top Up" class="btn-secondary" invisible="state != 'in_progress'"/>
                    <button name="button_petty_cash_iou_request" type="object" string="IOU Request" class="btn-secondary" invisible="state != 'in_progress'"/>
                    <button name="button_petty_reimbursement" type="object" string="Reimbursement" class="btn-secondary" invisible="state != 'in_progress'"/>
                    <button name="button_petty_cash_complete" type="object" string="Complete" class="btn-success" groups="petty_cash.petty_cash_group_manager" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,complete"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="move_id" invisible="1"/>
                        <field name="cash_issue_line_ids" invisible="1"/>
                        <field name="cash_out_line_ids" invisible="1"/>
                        <field name="cash_in_line_ids" invisible="1"/>
                        <button name="button_view_journal_entries" icon="fa-book" class="oe_stat_button" type="object" invisible="not move_id or state == 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entries</span>
                            </div>
                        </button>
                        <button name="action_button_petty_cash_in" icon="fa-arrow-circle-down" class="oe_stat_button" type="object" invisible="not cash_in_line_ids or state == 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Top Up(s)</span>
                            </div>
                        </button>
                        <button name="action_button_iou_requests" icon="fa-hand-holding-usd" class="oe_stat_button" type="object" invisible="not cash_issue_line_ids or state == 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">IOU Request(s)</span>
                            </div>
                        </button>
                        <button name="action_button_reimbursement" icon="fa-receipt" class="oe_stat_button" type="object" invisible="not cash_out_line_ids or state == 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Reimbursement(s)</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Drawer Reference" class="text-muted small"/>
                        <h1 class="d-flex align-items-center">
                            <field name="name" placeholder="Petty Cash Drawer Name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Drawer Information">
                            <field name="journal_id" options="{'no_create': True, 'no_create_edit': True}" readonly="state != 'draft'"/>
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                            <field name="is_transferred" invisible="1"/>
                        </group>
                        <group string="Financial Summary">
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" readonly="1" force_save="1" invisible="1" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="user_id" readonly="1" force_save="1" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="cash_flow" readonly="1" force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="state == 'draft'"/>
                            <field name="cash_out" readonly="1" force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="state == 'draft'"/>
                            <field name="cash_balance" readonly="1" force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="state == 'draft'" class="fw-bold fs-5 text-primary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions" invisible="state == 'draft'">
                            <field name="petty_cash_line_ids" readonly="1">
                                <list decoration-success="type == 'topup'" decoration-danger="type == 'reimbursement'" decoration-warning="type == 'iou_request'" create="false">
                                    <field name="name" string="Reference"/>
                                    <field name="type" widget="badge" decoration-success="type == 'topup'" decoration-danger="type == 'reimbursement'" decoration-warning="type == 'iou_request'"/>
                                    <field name="from_acc" optional="show"/>
                                    <field name="to_acc" optional="show"/>
                                    <field name="employee_id" optional="show"/>
                                    <field name="reason" optional="show"/>
                                    <field name="amount" widget="monetary" sum="Total Amount"/>
                                    <field name="user_id" optional="hide"/>
                                    <field name="approved_by" optional="hide"/>
                                    <field name="petty_cash_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_petty_cash_kanban" model="ir.ui.view">
        <field name="name">petty.cash.kanban</field>
        <field name="model">petty.cash</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="user_id"/>
                <field name="cash_balance"/>
                <field name="cash_flow"/>
                <field name="cash_out"/>
                <field name="currency_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3 d-flex flex-column justify-content-between h-100">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <strong class="o_kanban_record_title fs-5 text-primary text-truncate">
                                        <field name="name"/>
                                    </strong>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'in_progress'" decoration-muted="state == 'complete'"/>
                                </div>
                                <div class="text-muted small mb-3">
                                    <i class="fa fa-calendar me-1 text-primary"/> <field name="start_date"/> <span class="mx-1">→</span> <field name="end_date"/>
                                    <div class="mt-1"><i class="fa fa-user me-1 text-secondary"/> <field name="user_id"/></div>
                                </div>
                            </div>
                            <div class="bg-light p-2 rounded-3 border">
                                <div class="row g-2 text-center">
                                    <div class="col-4 border-end">
                                        <div class="text-muted small text-uppercase" style="font-size: 0.75rem;">Cash In</div>
                                        <div class="fw-bold text-success text-truncate"><field name="cash_flow" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                                    </div>
                                    <div class="col-4 border-end">
                                        <div class="text-muted small text-uppercase" style="font-size: 0.75rem;">Cash Out</div>
                                        <div class="fw-bold text-danger text-truncate"><field name="cash_out" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-muted small text-uppercase" style="font-size: 0.75rem;">Balance</div>
                                        <div class="fw-bold text-primary text-truncate"><field name="cash_balance" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-3 d-flex flex-column justify-content-between h-100">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <strong class="o_kanban_record_title fs-5 text-primary text-truncate">
                                        <field name="name"/>
                                    </strong>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'in_progress'" decoration-muted="state == 'complete'"/>
                                </div>
                                <div class="text-muted small mb-3">
                                    <i class="fa fa-calendar me-1 text-primary"/> <field name="start_date"/> <span class="mx-1">→</span> <field name="end_date"/>
                                    <div class="mt-1"><i class="fa fa-user me-1 text-secondary"/> <field name="user_id"/></div>
                                </div>
                            </div>
                            <div class="bg-light p-2 rounded-3 border">
                                <div class="row g-2 text-center">
                                    <div class="col-4 border-end">
                                        <div class="text-muted small text-uppercase" style="font-size: 0.75rem;">Cash In</div>
                                        <div class="fw-bold text-success text-truncate"><field name="cash_flow" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                                    </div>
                                    <div class="col-4 border-end">
                                        <div class="text-muted small text-uppercase" style="font-size: 0.75rem;">Cash Out</div>
                                        <div class="fw-bold text-danger text-truncate"><field name="cash_out" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-muted small text-uppercase" style="font-size: 0.75rem;">Balance</div>
                                        <div class="fw-bold text-primary text-truncate"><field name="cash_balance" widget="monetary" options="{'currency_field': 'currency_id'}"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Professional List View -->
    <record id="view_petty_cash_tree" model="ir.ui.view">
        <field name="name">petty.cash.tree</field>
        <field name="model">petty.cash</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Drawers" sample="1" decoration-info="state == 'draft'" decoration-success="state == 'in_progress'" decoration-muted="state == 'complete'">
                <field name="name" string="Drawer Name"/>
                <field name="journal_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="cash_flow" widget="monetary" sum="Total Cash In"/>
                <field name="cash_out" widget="monetary" sum="Total Cash Out"/>
                <field name="cash_balance" widget="monetary" sum="Total Balance" class="fw-bold"/>
                <field name="user_id" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'in_progress'" decoration-muted="state == 'complete'"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_filter" model="ir.ui.view">
        <field name="name">petty.cash.search</field>
        <field name="model">petty.cash</field>
        <field name="arch" type="xml">
            <search string="Petty Cash">
                <field name="name" string="Search" filter_domain="['|', ('name', 'ilike', self), ('journal_id', 'ilike', self)]"/>
                <field name="journal_id"/>
                <field name="user_id"/>
                <separator/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'complete')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Journal" name="journal" domain="[]" context="{'group_by': 'journal_id'}"/>
                    <filter string="Responsible User" name="user" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_petty_cash_in_form" model="ir.ui.view">
        <field name="name">petty.cash.in.form</field>
        <field name="model">petty.cash.in</field>
        <field name="arch" type="xml">
            <form string="Top Up Request">
                <header>
                    <button name="button_awaiting_approval_petty_cash_in" type="object" string="Send to Approval" class="btn-primary" groups="petty_cash.petty_cash_group_assistant" invisible="state != 'draft'"/>
                    <button name="button_approve_petty_cash_in" type="object" string="Approve" class="btn-success" groups="petty_cash.petty_cash_group_manager" invisible="state != 'awaiting_approval'"/>
                    <button name="button_petty_cash_toppedup" type="object" string="Top Up" class="btn-primary" groups="petty_cash.petty_cash_group_assistant" invisible="state != 'approved'"/>
                    <button name="set_to_draft" type="object" string="Set to Draft" class="btn-secondary" groups="petty_cash.petty_cash_group_assistant" invisible="state != 'reject'"/>
                    <button name="button_reject_petty_cash_in" type="object" string="Reject" class="btn-danger" groups="petty_cash.petty_cash_group_manager" invisible="state != 'awaiting_approval'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,awaiting_approval,approved,toppedup"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="move_id" invisible="1"/>
                        <button name="button_view_journal_entries" icon="fa-book" class="oe_stat_button" type="object" invisible="state != 'toppedup'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entries</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Top Up Reference" class="text-muted small"/>
                        <h1 class="d-flex">
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request Details">
                            <field name="is_wizard" invisible="1"/>
                            <field name="petty_cash_id" domain="[('state', '=', 'in_progress')]" options="{'no_create': True, 'no_create_edit': True}" readonly="(is_wizard == True) or (state != 'draft')"/>
                            <field name="petty_cash_journal_id" invisible="1"/>
                            <field name="journal_id" string="Source Account (Journal)" options="{'no_create': True, 'no_create_edit': True}" invisible="state == 'draft'" readonly="state != 'awaiting_approval'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" required="1" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'" class="fw-bold fs-5 text-success"/>
                            <field name="reason" readonly="state != 'draft'"/>
                            <field name="note" readonly="state != 'draft'"/>
                        </group>
                        <group string="Dates &amp; Approvals">
                            <field name="request_date" readonly="state != 'draft'"/>
                            <field name="cash_date" readonly="1" invisible="not cash_date"/>
                            <field name="user_id" options="{'no_create': True, 'no_create_edit': True}" readonly="1" force_save="1"/>
                            <field name="company_id" options="{'no_create': True, 'no_create_edit': True}" invisible="1" readonly="state != 'draft'"/>
                            <field name="approved_by" readonly="1" invisible="not approved_by"/>
                            <field name="approved_date" readonly="1" invisible="not approved_date"/>
                            <field name="approver_comment" readonly="1" invisible="not approver_comment"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_petty_cash_in_tree" model="ir.ui.view">
        <field name="name">petty.cash.in.tree</field>
        <field name="model">petty.cash.in</field>
        <field name="arch" type="xml">
            <list string="Top Up Requests" sample="1" decoration-info="state == 'draft'" decoration-warning="state == 'awaiting_approval'" decoration-primary="state == 'approved'" decoration-success="state == 'toppedup'" decoration-danger="state == 'reject'">
                <field name="name"/>
                <field name="petty_cash_id"/>
                <field name="request_date" string="Requested Date"/>
                <field name="user_id" string="Requested By"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" widget="monetary" sum="Total Top Up"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'awaiting_approval'" decoration-primary="state == 'approved'" decoration-success="state == 'toppedup'" decoration-danger="state == 'reject'"/>
                <field name="approved_by" optional="hide"/>
                <field name="approver_comment" optional="hide"/>
                <field name="approved_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_in_filter" model="ir.ui.view">
        <field name="name">petty.cash.in.search</field>
        <field name="model">petty.cash.in</field>
        <field name="arch" type="xml">
            <search string="Top Up Requests">
                <field name="name" string="Search" filter_domain="['|', ('name', 'ilike', self), ('petty_cash_id', 'ilike', self)]"/>
                <field name="user_id"/>
                <field name="journal_id"/>
                <field name="state"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Awaiting Approval" name="awaiting_approval" domain="[('state', '=', 'awaiting_approval')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Topped Up" name="toppedup" domain="[('state', '=', 'toppedup')]"/>
                <filter string="Rejected" name="reject" domain="[('state', '=', 'reject')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Petty Cash Drawer" name="petty_cash" domain="[]" context="{'group_by': 'petty_cash_id'}"/>
                    <filter string="Source Account" name="account" domain="[]" context="{'group_by': 'journal_id'}"/>
                    <filter string="Requested By" name="user" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_petty_cash_out_form" model="ir.ui.view">
        <field name="name">petty.cash.out.form</field>
        <field name="model">petty.cash.out</field>
        <field name="arch" type="xml">
            <form string="Reimbursement Settlement">
                <header>
                    <field name="is_exceed_the_minimum" invisible="1"/>
                    <button name="button_awaiting_approval_petty_cash_out" type="object" string="Request Approval" class="btn-primary" groups="petty_cash.petty_cash_group_assistant" invisible="(is_exceed_the_minimum == False) or (state != 'draft')"/>
                    <button name="button_reimbursement_petty_cash_out" type="object" string="Direct Cash Issue" class="btn-primary" groups="petty_cash.petty_cash_group_assistant" invisible="(is_exceed_the_minimum == True) or (state != 'draft')"/>
                    <button name="button_approve_petty_cash_out" type="object" string="Approve" class="btn-success" groups="petty_cash.petty_cash_group_manager" invisible="state != 'awaiting_approval'"/>
                    <button name="button_reimbursement_petty_cash_out" type="object" string="Cash Issue" class="btn-primary" groups="petty_cash.petty_cash_group_assistant" invisible="(is_exceed_the_minimum == False) or (state != 'approved')"/>
                    <button name="button_function_set_to_draft" type="object" class="btn-secondary" string="Set To Draft" groups="petty_cash.petty_cash_group_assistant" invisible="state != 'reject'"/>
                    <button name="button_reject_petty_cash_out" type="object" string="Reject" class="btn-danger" groups="petty_cash.petty_cash_group_manager" invisible="state != 'awaiting_approval'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,awaiting_approval,approved,complete"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="move_id" invisible="1"/>
                        <button name="button_view_journal_entries" icon="fa-book" class="oe_stat_button" type="object" invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entries</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Reimbursement Reference" class="text-muted small"/>
                        <h1 class="d-flex">
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="is_wizard" invisible="1"/>
                            <field name="petty_cash_id" domain="[('state', '=', 'in_progress')]" options="{'no_create': True, 'no_create_edit': True}" readonly="(is_wizard == True) or (state != 'draft')"/>
                            <field name="employee_id" options="{'no_create': True, 'no_create_edit': True}" readonly="state != 'draft'"/>
                            <field name="reason" options="{'no_create': True, 'no_create_edit': True}" readonly="state != 'draft'"/>
                            <field name="remarks" readonly="state != 'draft'"/>
                            <field name="user_id" readonly="1" force_save="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Payment &amp; Verification">
                            <field name="cash_date" readonly="state in ('paid', 'done', 'cancel')"/>
                            <field name="cheque_no" readonly="state in ('done', 'cancel')"/>
                            <field name="checked_by" readonly="state in ('done', 'cancel')"/>
                            <field name="approved_by" readonly="1" force_save="1" invisible="not approved_by"/>
                            <field name="approved_date" readonly="1" invisible="not approved_date"/>
                            <field name="approver_comment" readonly="1" invisible="not approver_comment"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Expense Lines">
                            <field name="expenses_line" readonly="state not in ['draft']">
                                <list editable="bottom">
                                    <field name="name" placeholder="Description / Memo"/>
                                    <field name="cash_out_id" column_invisible="1"/>
                                    <field name="expense_account_id" options="{'no_create': True, 'no_create_edit': True}" required="1"/>
                                    <field name="attachment_id" widget="many2many_binary" string="Receipts"/>
                                    <field name="amount" widget="monetary" sum="Total"/>
                                </list>
                            </field>
                            <group name="note_group" col="6" class="mt-2 mt-md-0">
                                <group colspan="4"/>
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="cash_total">
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                        <label for="expensed_amount" string="Total Reimbursement"/>
                                    </div>
                                    <field name="expensed_amount" nolabel="1" class="oe_subtotal_footer_separator fw-bold fs-5 text-danger" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </group>
                                <div class="oe_clear"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_petty_cash_out_tree" model="ir.ui.view">
        <field name="name">petty.cash.out.tree</field>
        <field name="model">petty.cash.out</field>
        <field name="arch" type="xml">
            <list string="Reimbursements" sample="1" decoration-info="state == 'draft'" decoration-warning="state == 'awaiting_approval'" decoration-primary="state == 'approved'" decoration-success="state == 'complete'" decoration-danger="state == 'reject'">
                <field name="name"/>
                <field name="petty_cash_id"/>
                <field name="employee_id"/>
                <field name="reason"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="expensed_amount" widget="monetary" sum="Total Expensed" class="fw-bold"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'awaiting_approval'" decoration-primary="state == 'approved'" decoration-success="state == 'complete'" decoration-danger="state == 'reject'"/>
                <field name="is_approve" column_invisible="1"/>
                <field name="approved_by" optional="hide"/>
                <field name="approver_comment" optional="hide"/>
                <field name="approved_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_out_filter" model="ir.ui.view">
        <field name="name">petty.cash.out.search</field>
        <field name="model">petty.cash.out</field>
        <field name="arch" type="xml">
            <search string="Reimbursements">
                <field name="name" string="Search" filter_domain="['|', ('name', 'ilike', self), ('employee_id', 'ilike', self)]"/>
                <field name="employee_id"/>
                <field name="reason"/>
                <field name="state"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Awaiting Approval" name="awaiting_approval" domain="[('state', '=', 'awaiting_approval')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Completed" name="done" domain="[('state', '=', 'complete')]"/>
                <filter string="Cancelled" name="cancel" domain="[('state', '=', 'reject')]"/>
                <separator/>
                <filter string="Date" name="cash_dates" date="cash_date"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="employee_id" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter string="Reason" name="reason" domain="[]" context="{'group_by': 'reason'}"/>
                    <filter string="Petty Cash Drawer" name="petty_cash" domain="[]" context="{'group_by': 'petty_cash_id'}"/>
                    <filter string="Date" name="cash_date" domain="[]" context="{'group_by': 'cash_date'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_petty_cash_out_reason_tree" model="ir.ui.view">
        <field name="name">petty.cash.out.reason.tree</field>
        <field name="model">petty.cash.reason</field>
        <field name="arch" type="xml">
            <list string="Reimbursement Reasons" editable="top" sample="1">
                <field name="name" string="Reason Description"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_release_form" model="ir.ui.view">
        <field name="name">petty.cash.release.form</field>
        <field name="model">petty.cash.release</field>
        <field name="arch" type="xml">
            <form string="IOU Request">
                <header>
                    <button name="button_request_approval_petty_cash_release" type="object" string="Request Approval" class="btn-primary" groups="petty_cash.petty_cash_group_assistant" invisible="state != 'draft'"/>
                    <button name="button_approve_petty_cash_release" type="object" string="Approve" class="btn-success" groups="petty_cash.petty_cash_group_manager" invisible="state != 'awaiting_approval'"/>
                    <button name="button_petty_cash_released" type="object" string="Cash Issue" class="btn-primary" groups="petty_cash.petty_cash_group_assistant" invisible="state != 'approved'"/>
                    <button name="button_petty_cash_complete" type="object" string="Complete Settlement" class="btn-success" groups="petty_cash.petty_cash_group_assistant" invisible="state != 'released'"/>
                    <button name="set_to_draft" type="object" string="Set to Draft" class="btn-secondary" groups="petty_cash.petty_cash_group_assistant" invisible="state != 'reject'"/>
                    <button name="button_reject_petty_cash_release" type="object" string="Reject" class="btn-danger" groups="petty_cash.petty_cash_group_manager" invisible="state != 'awaiting_approval'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,awaiting_approval,approved,released,complete"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="move_id" invisible="1"/>
                        <button name="button_view_journal_entries" icon="fa-book" class="oe_stat_button" type="object" invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entries</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="IOU Reference" class="text-muted small"/>
                        <h1 class="d-flex">
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request Information">
                            <field name="is_wizard" invisible="1"/>
                            <field name="petty_cash_id" domain="[('state', '=', 'in_progress')]" options="{'no_create': True, 'no_create_edit': True}" readonly="(is_wizard == True) or (state != 'draft')"/>
                            <field name="employee_id" options="{'no_create': True, 'no_create_edit': True}" readonly="state != 'draft'"/>
                            <field name="reason" options="{'no_create': True, 'no_create_edit': True}" readonly="state != 'draft'"/>
                            <field name="remarks" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1" readonly="state != 'draft'"/>
                        </group>
                        <group string="Financial Details &amp; Approvals">
                            <field name="release_date" readonly="state != 'draft'"/>
                            <field name="released_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'" class="fw-bold fs-5 text-warning"/>
                            <field name="expensed_amount" readonly="1" force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="state not in ('released', 'complete')"/>
                            <field name="balanced_amount" invisible="1"/>
                            <field name="user_id" readonly="1" force_save="1"/>
                            <field name="approved_by" readonly="1" invisible="not approved_by"/>
                            <field name="approved_date" readonly="1" invisible="not approved_date"/>
                            <field name="approver_comment" readonly="1" invisible="not approver_comment"/>
                            <field name="cheque_no" readonly="state in ('done', 'cancel')" optional="hide"/>
                            <field name="checked_by" readonly="state in ('done', 'cancel')" optional="hide"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Expense Settlement Lines" invisible="state not in ('released', 'complete')" readonly="state == 'complete'">
                            <field name="expenses_line" invisible="state not in ('released', 'complete')" readonly="state == 'complete'">
                                <list editable="bottom">
                                    <field name="name" placeholder="Expense Description"/>
                                    <field name="cash_release_id" column_invisible="1"/>
                                    <field name="expense_account_id" required="parent.state == 'released'" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="attachment_id" widget="many2many_binary" string="Receipts"/>
                                    <field name="amount" widget="monetary" sum="Total Expensed"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_petty_cash_release_tree" model="ir.ui.view">
        <field name="name">petty.cash.release.tree</field>
        <field name="model">petty.cash.release</field>
        <field name="arch" type="xml">
            <list string="IOU Requests" sample="1" decoration-info="state == 'draft'" decoration-warning="state in ('awaiting_approval', 'released')" decoration-primary="state == 'approved'" decoration-success="state == 'complete'" decoration-danger="state == 'reject'">
                <field name="name"/>
                <field name="petty_cash_id"/>
                <field name="release_date" string="Requested Date"/>
                <field name="employee_id"/>
                <field name="reason"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="released_amount" widget="monetary" sum="Total Released" class="fw-bold"/>
                <field name="expensed_amount" widget="monetary" sum="Total Expensed" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'awaiting_approval'" decoration-primary="state == 'approved'" decoration-success="state == 'complete'" decoration-danger="state == 'reject'"/>
                <field name="approved_by" optional="hide"/>
                <field name="approver_comment" optional="hide"/>
                <field name="approved_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_release_filter" model="ir.ui.view">
        <field name="name">petty.cash.release.search</field>
        <field name="model">petty.cash.release</field>
        <field name="arch" type="xml">
            <search string="IOU Requests">
                <field name="name" string="Search" filter_domain="['|', ('name', 'ilike', self), ('employee_id', 'ilike', self)]"/>
                <field name="employee_id"/>
                <field name="reason"/>
                <field name="state"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Awaiting Approval" name="awaiting_approval" domain="[('state', '=', 'awaiting_approval')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Cash Issued" name="release" domain="[('state', '=', 'released')]"/>
                <filter string="Completed" name="complete" domain="[('state', '=', 'complete')]"/>
                <filter string="Cancelled" name="cancel" domain="[('state', '=', 'reject')]"/>
                <separator/>
                <filter string="Issue Date" name="release_date" date="release_date"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="employee_id" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter string="Reason" name="reason" domain="[]" context="{'group_by': 'reason'}"/>
                    <filter string="Petty Cash Drawer" name="petty_cash" domain="[]" context="{'group_by': 'petty_cash_id'}"/>
                    <filter string="Issue Date" name="release_date" domain="[]" context="{'group_by': 'release_date'}"/>
                    <filter string="Status" name="status" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
